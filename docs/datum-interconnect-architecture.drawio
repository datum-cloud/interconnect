        <mxCell id="3" value="&lt;b&gt;&lt;font size='3' color='#DDD6FE'&gt;NEOCLOUDS &amp;amp; AI COMPUTE CLOUDS&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#A78BFA' size='2'&gt;High-Density GPU Clusters • Foundation Model Training • Inference Engines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2E1065;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;align=center;opacity=90;" parent="1" vertex="1">
