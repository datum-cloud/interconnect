        <mxCell id="9" value="&lt;b&gt;Hyperscaler VPCs &amp;amp; Transit Gateways&lt;/b&gt;&lt;br/&gt;&lt;font color='#FDE68A'&gt;• AWS TGW / Private Subnets (172.31.0.0/16)&lt;br/&gt;• GCP Cloud Routers &amp;amp; Interconnect Attachments&lt;br/&gt;• Azure ExpressRoute Gateways&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#78350F;strokeColor=#D97706;fontColor=#FEF3C7;align=left;" parent="1" vertex="1">
