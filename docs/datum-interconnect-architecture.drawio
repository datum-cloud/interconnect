        <mxCell id="7" value="&lt;b&gt;&lt;font size='3' color='#FED7AA'&gt;HYPERSCALERS &amp;amp; ENTERPRISE CLOUDS&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#FB923C' size='2'&gt;Enterprise Data Lakes • Identity • Relational Databases • Mission-Critical SaaS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#451A03;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=center;opacity=90;" parent="1" vertex="1">
          <mxGeometry x="1390" y="130" width="480" height="440" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;AWS / GCP / Microsoft Azure / OCI&lt;/b&gt;&lt;br/&gt;&lt;font color='#FDE68A'&gt;• Amazon S3 Training Lakes, RDS, Aurora&lt;br/&gt;• Google BigQuery &amp;amp; Vertex AI Services&lt;br/&gt;• Azure Entra ID / Corporate Active Directory&lt;br/&gt;&lt;b&gt;Challenge:&lt;/b&gt; Vendor lock-in, proprietary interconnects (DirectConnect/ExpressRoute), egress tax.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#78350F;strokeColor=#D97706;fontColor=#FEF3C7;align=left;" parent="1" vertex="1">
          <mxGeometry x="1410" y="200" width="440" height="100" as="geometry" />
