        <mxCell id="10" value="&lt;b&gt;Interconnect Gateway / Partner Tunnel&lt;/b&gt;&lt;br/&gt;&lt;font color='#FED7AA'&gt;• High-speed BGP Peering (802.1Q VLANs)&lt;br/&gt;• Dynamic IPsec / WireGuard / MASQUE gateway&lt;br/&gt;• Automated BGP route synchronization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#92400E;strokeColor=#F59E0B;fontColor=#FFFFFF;strokeWidth=2;align=left;" parent="1" vertex="1">
