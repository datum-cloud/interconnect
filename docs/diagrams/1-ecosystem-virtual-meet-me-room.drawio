        <mxCell id="6" value="&lt;b&gt;datum-connect Daemon / Galactic Node&lt;/b&gt;&lt;br/&gt;&lt;font color='#DDD6FE'&gt;• Headless Rust daemon + Go supervisor&lt;br/&gt;• Iroh P2P QUIC + MASQUE CONNECT-IP&lt;br/&gt;• Zero-config dynamic peering via ed25519 identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#4C1D95;strokeColor=#A855F7;fontColor=#FFFFFF;strokeWidth=2;align=left;" parent="1" vertex="1">
          <mxGeometry x="70" y="435" width="440" height="115" as="geometry" />
