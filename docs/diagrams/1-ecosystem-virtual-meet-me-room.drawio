        <mxCell id="5" value="&lt;b&gt;Workloads &amp;amp; Endpoints&lt;/b&gt;&lt;br/&gt;&lt;font color='#C4B5FD'&gt;• Distributed PyTorch / vLLM workers&lt;br/&gt;• Checkpoint streaming pipelines&lt;br/&gt;• Model serving APIs&lt;br/&gt;• Internal RFC 4193 ULA / Private IPs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#3B0764;strokeColor=#7C3AED;fontColor=#EDE9FE;align=left;" parent="1" vertex="1">
          <mxGeometry x="70" y="320" width="440" height="95" as="geometry" />
