        </mxCell>
        <mxCell id="14" value="&lt;b&gt;LAYER 3: DYNAMIC TUNNEL &amp;amp; CONNECTIVITY RUNTIME (Iroh + MASQUE)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' size='2'&gt;Overcoming Corporate NATs, Symmetric Firewalls, and Strict Network Boundaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#172554;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="480" width="1750" height="160" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;datum-connect Agent&lt;/b&gt;&lt;br/&gt;Rust crate + Go supervisor&lt;br/&gt;Runs on hosts, containers, laptops&lt;br/&gt;STUN hole punch + QUIC streams" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E40AF;strokeColor=#60A5FA;fontColor=#EFF6FF;" parent="1" vertex="1">
          <mxGeometry x="70" y="535" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;Iroh Global Relay Mesh&lt;/b&gt;&lt;br/&gt;Stateless UDP relaying on port 443&lt;br/&gt;Provides 100% traversal fallback&lt;br/&gt;Site-specific routable /48 IPv6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E40AF;strokeColor=#60A5FA;fontColor=#EFF6FF;" parent="1" vertex="1">
          <mxGeometry x="490" y="535" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;IETF MASQUE Protocol Suite&lt;/b&gt;&lt;br/&gt;RFC 9484 CONNECT-IP (L3 IP Tunnel)&lt;br/&gt;RFC 9298 CONNECT-UDP (Relaying)&lt;br/&gt;HTTP CONNECT-TCP (Proxying)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E40AF;strokeColor=#60A5FA;fontColor=#EFF6FF;" parent="1" vertex="1">
          <mxGeometry x="930" y="535" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;Dynamic IP Assignment&lt;/b&gt;&lt;br/&gt;Allocates client IP inside VPC space&lt;br/&gt;Distributes allowed routes via capsule&lt;br/&gt;HeartbeatAgent liveness renewal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E40AF;strokeColor=#60A5FA;fontColor=#EFF6FF;" parent="1" vertex="1">
          <mxGeometry x="1370" y="535" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;LAYER 4: HIGH-PERFORMANCE OVERLAY DATA PLANE (KERNEL &amp;amp; eBPF)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' size='2'&gt;Deterministic Hardware-Grade Routing, Isolation, and Load Balancing in Software&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#311042;strokeColor=#A855F7;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="670" width="1750" height="160" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;SRv6 Micro-SID (uSID) Engine&lt;/b&gt;&lt;br/&gt;TC-eBPF decap &amp;amp; encap in kernel&lt;br/&gt;Compresses routing segment lists&lt;br/&gt;Direct Pod-to-Pod cross-cluster paths" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#581C87;strokeColor=#C084FC;fontColor=#FAF5FF;" parent="1" vertex="1">
          <mxGeometry x="70" y="725" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;Linux Kernel VRF Sandboxing&lt;/b&gt;&lt;br/&gt;Dedicated routing tables per tenant&lt;br/&gt;Guaranteed cryptographic multi-tenancy&lt;br/&gt;No leaky cross-tenant packet leaks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#581C87;strokeColor=#C084FC;fontColor=#FAF5FF;" parent="1" vertex="1">
          <mxGeometry x="500" y="725" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;Stateless Maglev DSR (XDP)&lt;/b&gt;&lt;br/&gt;Line-rate native eBPF driver hook&lt;br/&gt;Consistent hash-ring load balancing&lt;br/&gt;Direct Server Return: 0 return overhead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#581C87;strokeColor=#C084FC;fontColor=#FAF5FF;" parent="1" vertex="1">
          <mxGeometry x="930" y="725" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;Sharded Stateful NAT66 Egress&lt;/b&gt;&lt;br/&gt;Masquerades private VPC packets to GUA&lt;br/&gt;Atomic linear-probe port reservation&lt;br/&gt;Direct access to public internet APIs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#581C87;strokeColor=#C084FC;fontColor=#FAF5FF;" parent="1" vertex="1">
          <mxGeometry x="1360" y="725" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;LAYER 5: GLOBAL UNDERLAY FABRIC &amp;amp; PHYSICAL TRANSIT&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' size='2'&gt;FRR eBGP Fabric Router • Global Anycast • Tier-1 Transits • 17+ Metros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1C1917;strokeColor=#78716C;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="860" width="1750" height="160" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;fabric-router (FRR eBGP)&lt;/b&gt;&lt;br/&gt;Underlay BGP peering between physical nodes&lt;br/&gt;Global IPv6 unicast reachability on loopback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#292524;strokeColor=#A8A29E;fontColor=#F5F5F4;" parent="1" vertex="1">
          <mxGeometry x="70" y="915" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;BGP EVPN L3VPN Control Plane&lt;/b&gt;&lt;br/&gt;Embedded GoBGP daemon in galactic-router&lt;br/&gt;Distributes tenant EVPN routes fleet-wide" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#292524;strokeColor=#A8A29E;fontColor=#F5F5F4;" parent="1" vertex="1">
          <mxGeometry x="500" y="915" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;Per-Site /48 BGP Route Advertisements&lt;/b&gt;&lt;br/&gt;Site-specific IPv6 allocations to Tier-1s&lt;br/&gt;Enables globally-routable iroh-relay endpoints" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#292524;strokeColor=#A8A29E;fontColor=#F5F5F4;" parent="1" vertex="1">
          <mxGeometry x="930" y="915" width="400" height="85" as="geometry" />
        </mxCell>
