        <mxCell id="8" value="&lt;b&gt;LAYER 2: DECLARATIVE CONTROL PLANE (CRDs &amp;amp; OPERATORS)&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' size='2'&gt;Automated Reconciliation across Management &amp;amp; Data Plane Clusters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0F172A;strokeColor=#0284C7;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
